# Copie para .env. Nunca coloque uma chave real neste arquivo de exemplo.
# Nao existe troca automatica de provedor em caso de erro.
LLM_PROVIDER=ollama

# Groq: preencha a chave somente no .env local.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Gemini: crie uma chave no Google AI Studio e confira o nível gratuito do projeto.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Ollama local: instale o servidor e baixe este modelo separadamente.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

LLM_TIMEOUT_SECONDS=120

# Opcional: intervalo entre chamadas ao modelo na mesma sessão, inclusive ferramentas.
# Depende da cota do provedor/plano; 0 desativa. Não faz retry nem garante evitar cotas.
LLM_MIN_INTERVAL_SECONDS=0
