# Copy to .env. Never put a real key in this example file.
# There is no automatic provider fallback on errors.
# Key-free local default. Select gemini to reproduce the README demonstration.
LLM_PROVIDER=ollama

# Groq: set the key only in your local .env file.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Gemini: create a Google AI Studio key and check your project free-tier quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Local Ollama: install the server and download this model separately.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

LLM_TIMEOUT_SECONDS=120

# Optional: seconds between model requests in one session, including tool rounds.
# Depends on provider/plan quota; 0 disables pacing. No retry or quota guarantee.
LLM_MIN_INTERVAL_SECONDS=0
